{
  "catalogue_version": "v2-evidence-1.1",
  "design_version": "v2-evidence-1.0",
  "amendments": [
    {
      "version": "v2-evidence-1.1",
      "from": "v2-evidence-1.0",
      "approved": "Task 22 (design open decisions 1-2)",
      "changes": [
        "NET-1 restricted to scanning tools, or probe tools aimed at qualifying internal/scan targets (FP-4).",
        "NET-0 added (context): HTTP HEAD (curl -I/--head) and probe tools aimed at non-qualifying targets are reachability checks, never reconnaissance.",
        "AUTH-1/AUTH-2: >= 3 distinct failures within 300 s from the same observed src_ip; relay/NAT sources and sessions without attribution are 'indeterminate'.",
        "TIME-0 may carry an 'unusual timing' caveat from the reference timing calibration (caveat only)."
      ]
    }
  ],
  "indicators": [
    {
      "id": "AUTH-0",
      "name": "authentication failure in session",
      "category": "authentication",
      "kind": "context",
      "evidence_class": "directly_observed",
      "telemetry": [
        "cowrie.login.failed"
      ],
      "limitations": "a rejected login; says nothing about intent or other attempts",
      "outcome_capable": false
    },
    {
      "id": "AUTH-1",
      "name": "repeated authentication failures from one source",
      "category": "authentication",
      "kind": "action",
      "evidence_class": "directly_observed",
      "telemetry": [
        "cowrie.login.failed",
        "src_ip",
        "timestamp"
      ],
      "limitations": "one network source failed >= 3 times in 300 s; cannot separate actors behind shared/NAT/relay addresses",
      "outcome_capable": false
    },
    {
      "id": "AUTH-2",
      "name": "login success after repeated failures",
      "category": "authentication",
      "kind": "action",
      "evidence_class": "directly_observed",
      "telemetry": [
        "cowrie.login.failed",
        "cowrie.login.success",
        "src_ip",
        "timestamp"
      ],
      "limitations": "does not show the credentials were guessed rather than known",
      "outcome_capable": false
    },
    {
      "id": "SHELL-1",
      "name": "interactive command activity",
      "category": "execution",
      "kind": "context",
      "evidence_class": "directly_observed",
      "telemetry": [
        "cowrie.command.input (input)"
      ],
      "limitations": "commands were issued; not what they did",
      "outcome_capable": false
    },
    {
      "id": "DISC-1",
      "name": "system/identity discovery command",
      "category": "discovery",
      "kind": "context",
      "evidence_class": "directly_observed",
      "telemetry": [
